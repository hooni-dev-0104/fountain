# This file is documentation. The server reads process environment, not .env automatically.
# Optional family shared password. At least 16 characters; use a long random value.
FOUNTAIN_ACCESS_TOKEN=

# No AI provider is enabled by default. Use an installed LOCAL model with no API fee:
FOUNTAIN_AI_PROVIDER=compatible-http
FOUNTAIN_AI_URL=http://127.0.0.1:11434/v1/chat/completions
FOUNTAIN_AI_MODEL=
FOUNTAIN_AI_KEY=

# Optional SCIM provisioning API. Independent from the family password.
FOUNTAIN_SCIM_TOKEN=
